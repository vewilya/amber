# --- Build output (CMake + Zed tasks write here) ---
build/
cmake-build-*/
CMakeUserPresets.json

# --- C compiler artifacts (stray, outside build/) ---
*.o
*.obj
*.a
*.so
*.dylib
*.dSYM/
*.s
*_test
*_main

# --- Editor / language server caches ---
# clangd index, neocmakelsp
.cache/
# regenerated by CMake into build/
compile_commands.json

# --- Python (libs/torchline/python) ---
__pycache__/
*.py[oc]
.venv/
*.egg-info/
dist/
wheels/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Claude Code local state ---
.claude/.cc-writes/
.claude/settings.local.json

# --- macOS ---
.DS_Store
._*
